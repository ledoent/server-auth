<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.auth.oauth.link.existing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- The Integrations block is anchored by name=, not id=, in
                 base_setup/views/res_config_settings_views.xml on 19.0. -->
            <xpath expr="//block[@name='integration']" position="inside">
                <setting
                    id="auth_oauth_link_allowed_domains_setting"
                    string="OAuth link allowed domains"
                    help="Restrict which email domains may be linked to an existing user when signing in with OAuth. Leave empty to allow any domain the provider has verified."
                >
                    <field name="auth_oauth_link_allowed_domains" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
